# Server-side only. Never prefix this with NEXT_PUBLIC_ — that would ship the
# key to every browser that loads the page.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to qwen/qwen3.8-27b, the only image-capable model on
# Groq's free tier.
# GROQ_MODEL=qwen/qwen3.8-27b
